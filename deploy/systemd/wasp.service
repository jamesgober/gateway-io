# wasp as a systemd service: starts at boot, restarts after a crash, stops
# cleanly. See "Start at boot" in the README for the steps.
#
#   /opt/wasp            the binary and the theme (read-only)
#   /etc/wasp/wasp.conf  the configuration (owned by root, readable by wasp)
#   /var/lib/wasp        the data (the database, gate.key)
#   /var/log/wasp        logs, when log.file is on (the journal has stderr)
#
# Install as /etc/systemd/system/wasp.service, then:
#   systemctl daemon-reload && systemctl enable --now wasp

[Unit]
Description=WASP site
Wants=network-online.target
After=network-online.target

[Service]
# wasp tells systemd when it is serving (READY=1) and when it is stopping.
Type=notify
NotifyAccess=main
User=wasp
Group=wasp
WorkingDirectory=/opt/wasp
ExecStart=/opt/wasp/wasp
# SIGHUP reloads the configuration (bans, drain time, sign-in settings).
ExecReload=/bin/kill -HUP $MAINPID

Environment=WASP_CONFIG=/etc/wasp/wasp.conf
# Only for the first start: WASP_ADMIN_PASSWORD=... in this file (mode 600,
# owned by root), removed once the boot account exists.
EnvironmentFile=-/etc/wasp/wasp.env

# Every folder wasp uses, made by systemd and private to the service:
# wasp refuses a log or runtime folder that other users can read.
StateDirectory=wasp
StateDirectoryMode=0700
LogsDirectory=wasp
LogsDirectoryMode=0700
CacheDirectory=wasp
CacheDirectoryMode=0700
RuntimeDirectory=wasp
RuntimeDirectoryMode=0700
ConfigurationDirectory=wasp
ConfigurationDirectoryMode=0750
Environment=WASP_DATA_DIR=/var/lib/wasp
Environment=WASP_STATE_DIR=/var/lib/wasp/state
Environment=WASP_LOGS_DIR=/var/log/wasp
Environment=WASP_CACHE_DIR=/var/cache/wasp
Environment=WASP_TEMP_DIR=/var/cache/wasp/tmp
Environment=WASP_RUNTIME_DIR=/run/wasp
Environment=WASP_CONFIG_DIR=/etc/wasp
UMask=0077

# A stop: SIGTERM closes the door, drains (gateway.drain, 10 s by default),
# then stops the core. Give it longer than the drain before SIGKILL.
KillSignal=SIGTERM
TimeoutStopSec=30
TimeoutStartSec=60

# Restart after a crash, but not after a refusal that a restart cannot fix:
# 78 is a configuration wasp cannot load, 77 a folder others can read.
Restart=on-failure
RestartSec=2
RestartPreventExitStatus=77 78

# Hardening: wasp needs its own folders and the network, nothing else.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
# To listen on a port under 1024 (80, 443) without root, give it this one:
# AmbientCapabilities=CAP_NET_BIND_SERVICE
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
