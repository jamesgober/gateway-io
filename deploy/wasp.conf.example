# wasp.conf for a site on a cPanel host (Passenger).
# Copy this file to wasp.conf next to the wasp binary, then change the two
# lines marked CHANGE. A key wasp does not know stops it at boot, with the
# key's name in the log.

[log]
# Warnings and errors only. Passenger keeps this output in a log file that
# it never rotates, so a busy log can fill the account's disk quota.
level = "warn"
file = false

[site]
# CHANGE: your domain names, the main one first.
hosts = ["example.com", "www.example.com"]
theme = "themes/default"

[content]
store = "nex"

# Fields of your own for posts or pages (the README's "Custom fields"):
# [content.fields.post.author]
# type = "text"
# label = "Author"

[auth]
store = "nex"
# CHANGE: the email you sign in with. Its password comes from the
# WASP_ADMIN_PASSWORD environment variable, never from this file.
admin = "you@example.com"

# The sign-in rules have safe defaults; the README's "Sign-in settings"
# lists every key. For example, longer passwords and shorter sessions:
# [auth.password]
# min_length = 14
# [auth.session]
# idle = "1d"

# The JSON API at /api/v1 (the README's "API") is off. To turn it on, with
# each account getting 10 requests a second:
# [api]
# enabled = true
# prefix = "/api/v1"
# rate = 10

[nex]
# The database, inside the application folder's data folder.
path = "data/nex"

[gateway]
# Small numbers for a shared host: the account gets a share of the CPUs and
# memory, not the whole machine.
workers = 2
passports = 64
# One log line per request. Turn it on to troubleshoot, then off again.
access_log = false
